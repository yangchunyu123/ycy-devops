---
import { SITE } from '../config';
import { PROFILE } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const initials = PROFILE.name
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => [...w][0])
	.join('')
	.toUpperCase();
---

<header class="topbar">
	<a class="brand" href="/">
		<span class="mark">
			{PROFILE.avatar ? <img src={PROFILE.avatar} alt="" width="40" height="40" /> : initials}
		</span>
		<span class="name">{SITE.title}</span>
	</a>
	<ThemeToggle />
</header>

<style>
	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.25rem 1.25rem 0;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.3rem 1rem 0.3rem 0.3rem;
		border: 1px solid var(--tile-border);
		border-radius: 999px;
		background: var(--tile);
		-webkit-backdrop-filter: var(--blur);
		backdrop-filter: var(--blur);
		color: var(--fg);
		text-decoration: none;
	}
	.mark {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		overflow: hidden;
		border-radius: 50%;
		background: var(--grad);
		color: #fff;
		font: 800 0.8rem var(--font-mono);
	}
	.mark img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.name {
		font-weight: 900;
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
