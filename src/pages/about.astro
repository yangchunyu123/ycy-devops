---
import Icon from '../components/Icon.astro';
import { SOCIAL_LINKS } from '../config';
import { PROFILE } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const hasBio = PROFILE.about.length > 0;
const initials = PROFILE.name
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => [...w][0])
	.join('')
	.toUpperCase();
---

<BaseLayout title="About" description={PROFILE.about[0] ?? PROFILE.role}>
	<div class="about">
		<section class="tile card pop">
			<div class="avatar">
				{PROFILE.avatar ? <img src={PROFILE.avatar} alt={PROFILE.name} width="128" height="128" /> : initials}
			</div>
			<p class="label">About</p>
			<h1 class="display name gradient-text">{PROFILE.name}</h1>
			<p class="role">{PROFILE.role}</p>
			{
				PROFILE.location && (
					<p class="location">
						<Icon name="pin" size={15} /> {PROFILE.location}
					</p>
				)
			}
			{
				SOCIAL_LINKS.length > 0 && (
					<ul class="links">
						{SOCIAL_LINKS.map((link) => (
							<li>
								<a class="chip" href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
									<Icon name={link.icon} size={14} /> {link.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</section>

		<div class="side">
			{
				hasBio && (
					<section class="tile bio pop" style="--i: 1">
						<p class="label">Bio</p>
						<div class="prose">
							{PROFILE.about.map((p) => (
								<p>{p}</p>
							))}
						</div>
					</section>
				)
			}

			<section class="tile interests pop" style="--i: 2">
				<p class="label">Interests</p>
				<ul>
					{
						PROFILE.hobbies.map((h) => (
							<li>
								<span class="h-icon">
									<Icon name={h.icon} size={18} />
								</span>
								<span>
									<strong>{h.title}</strong>
									<span class="muted">{h.text}</span>
								</span>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.about {
		display: grid;
		grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}
	.card {
		position: sticky;
		top: 1.5rem;
		padding: 2rem;
		text-align: center;
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 8rem;
		height: 8rem;
		margin: 0 auto 1.5rem;
		overflow: hidden;
		border-radius: 50%;
		background: var(--grad);
		box-shadow:
			0 0 0 6px var(--tile-strong),
			0 0 0 8px var(--accent),
			0 12px 40px rgba(255, 62, 165, 0.4);
		color: #fff;
		font: 900 2.4rem var(--font-mono);
	}
	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.name {
		font-size: clamp(2rem, 5vw, 2.6rem);
		overflow-wrap: anywhere;
	}
	.role {
		margin: 0.8rem 0 0;
		color: var(--fg-soft);
		font-weight: 600;
	}
	.location {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-size: 0.92rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
	}

	.side {
		display: grid;
		gap: 1rem;
	}
	.bio {
		padding: 2rem;
	}
	.interests ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		gap: 0.25rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.interests li {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		padding: 0.7rem 0;
		border-bottom: 1px dashed var(--border);
	}
	.interests li > span:last-child {
		display: flex;
		flex-direction: column;
		font-size: 0.93rem;
	}
	.interests strong {
		color: var(--fg);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.95rem;
	}
	.h-icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		background: var(--grad);
		color: #fff;
	}

	@media (max-width: 820px) {
		.about {
			grid-template-columns: 1fr;
		}
		.card {
			position: static;
		}
	}
</style>
